# freeChat Environment Configuration

# Server Port
PORT=3000

# JWT Secret for signing API session tokens (generate a strong random 64-char key in production)
JWT_SECRET=your-random-jwt-secret-key-replace-in-production

# Supabase PostgreSQL Cloud Configuration (Optional)
# If left empty, freeChat automatically uses the built-in local persistent store (database/local_db.json)
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use your Supabase service_role secret key for the backend server so operations succeed with RLS enabled
SUPABASE_KEY=your-supabase-service-role-secret-key
# Allowed CORS Origins for production (comma-separated whitelist; leave empty to allow localhost/127.0.0.1 and same-origin)
ALLOWED_ORIGINS=https://your-domain.com,https://staging.your-domain.com
